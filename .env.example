# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local to version control.

# Base URL of the deployed site, used in metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain-here.com

# Optional: if you wire the correction form to a real email or form service
# (e.g. Resend, Formspree, or a custom API route), add its credentials here
# and read them only on the server — never expose an API key with the
# NEXT_PUBLIC_ prefix.
# CONTACT_FORM_API_KEY=

# ── Web Push Notifications ────────────────────────────────────────────────────
# Generate a fresh VAPID key pair with:
#   node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2));"
#
# NEXT_PUBLIC_ prefix is intentional — the public key must be readable in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Email shown in the VAPID header (must be a valid mailto: address)
VAPID_MAILTO=admin@your-domain-here.com

# Secret header value used to protect the /api/push-send endpoint.
# Send this in the "x-push-secret" header when triggering a broadcast.
PUSH_ADMIN_SECRET=change_me_to_a_long_random_string
